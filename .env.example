# ---------------------------------------------------------------------------
# Loan Factory Team Leader OS — environment template
#
# HOW TO USE THIS FILE
#   1. Copy it:      cp .env.example .env
#   2. Fill in only the values for tools you actually use.
#   3. Never commit .env — .gitignore already blocks it.
#
# An "environment variable" is just a setting stored outside your files so that
# passwords and keys never end up in GitHub. You do not need to fill in
# everything. The system runs with none of these set; integrations simply stay
# switched off until you configure them.
# ---------------------------------------------------------------------------

# --- Where your private team information lives ------------------------------
# Defaults to ./team-data inside this repository (already gitignored).
# Point it somewhere outside the repo if you prefer extra separation.
TEAM_LEADER_OS_DATA_DIR=./team-data

# --- Hermes Agent gateway ----------------------------------------------------
# Only needed if you run the Hermes gateway and want tools to reach it.
HERMES_HOST=127.0.0.1
HERMES_PORT=8642
HERMES_API_KEY=

# --- Model provider (pick whichever you use; leave the rest blank) -----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Optional integrations ---------------------------------------------------
# NOTHING in this repository connects to these services out of the box.
# These names exist so that integrations you add later have a standard home.
# See docs/integrations.md for the current, honest status of each one.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
